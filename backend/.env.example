# Environment Variables — GTS Invoice System Backend
# Copy this file to .env and fill in all values before running the application.
# NEVER commit the .env file to source control.

# ─── Application ──────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=5000
APPLICATION_BASE_URL=http://localhost:5000

# ─── Database ─────────────────────────────────────────────────────────────────
# PostgreSQL connection string (Render provides this automatically in production)
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/gts_invoice?schema=public

# ─── Authentication ───────────────────────────────────────────────────────────
JWT_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_STRING_AT_LEAST_64_CHARS
JWT_EXPIRES_IN=24h
REFRESH_TOKEN_SECRET=CHANGE_ME_TO_ANOTHER_LONG_RANDOM_STRING
REFRESH_TOKEN_EXPIRES_IN=7d

# ─── Microsoft Entra ID / Graph API (Optional — email integration) ────────────
# Leave blank to run without Outlook integration
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=
MICROSOFT_REDIRECT_URI=http://localhost:5000/api/auth/microsoft/callback
MICROSOFT_GRAPH_SCOPES=Mail.Send,Mail.Read,offline_access

# ─── Document Storage ─────────────────────────────────────────────────────────
# Choose one storage provider. Leave others blank.

# Option A: Cloudinary (recommended for ease of setup)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Option B: AWS S3 / Render Object Storage / S3-compatible
S3_BUCKET=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_ENDPOINT=

# ─── Email Notifications ──────────────────────────────────────────────────────
# Used by background jobs when Outlook integration is not configured
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=noreply@gts.co.in

# ─── Redis (for Bull job queues — optional in development) ───────────────────
REDIS_URL=redis://localhost:6379

# ─── Logging ──────────────────────────────────────────────────────────────────
LOG_LEVEL=info

# ─── Security ─────────────────────────────────────────────────────────────────
BCRYPT_ROUNDS=12
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ─── Organisation Defaults ────────────────────────────────────────────────────
DEFAULT_TIMEZONE=Asia/Kolkata
DEFAULT_CURRENCY=INR
FINANCIAL_YEAR_START_MONTH=4
DEFAULT_SUBMISSION_WARNING_DAYS=3
DEFAULT_VARIANCE_TOLERANCE_PERCENT=5
